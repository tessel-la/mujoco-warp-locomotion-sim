FROM ghcr.io/astral-sh/uv:0.8.22-python3.12-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    MUJOCO_GL=egl \
    NVIDIA_DRIVER_CAPABILITIES=compute,graphics,utility \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_HTTP_TIMEOUT=600 \
    UV_LINK_MODE=copy

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        libegl1 \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libx11-6 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/microduck_rl
COPY training/microduck_rl ./
RUN uv sync --frozen --no-dev

ENTRYPOINT ["uv", "run"]
CMD ["train", "Mjlab-Velocity-Flat-MicroDuck", "--env.scene.num-envs", "4096"]
