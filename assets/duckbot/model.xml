<mujoco model="duckbot locomotion">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.005" gravity="0 0 -9.81" integrator="RK4" solver="CG" iterations="12" cone="pyramidal"/>
  <size njmax="512" nconmax="128"/>

  <default>
    <joint armature="0.002" damping="0.08" frictionloss="0.01" limited="true"/>
    <geom condim="3" friction="1.2 0.04 0.01" solref="0.008 1" solimp="0.9 0.95 0.001" density="500" rgba="0.94 0.68 0.08 1"/>
    <position kp="32" kv="2.2" ctrlrange="-1.5 1.5" forcerange="-8 8"/>
  </default>

  <asset>
    <texture name="floor_tex" type="2d" builtin="checker" width="256" height="256" rgb1="0.12 0.15 0.19" rgb2="0.23 0.27 0.31"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="8 8" reflectance="0.12"/>
    <material name="duck_yellow" rgba="0.96 0.70 0.08 1"/>
    <material name="duck_dark" rgba="0.11 0.14 0.18 1"/>
    <material name="beak" rgba="0.94 0.30 0.05 1"/>
  </asset>

  <worldbody>
    <light name="key" pos="1 -2 3" dir="-0.2 0.3 -1" diffuse="0.9 0.9 0.9"/>
    <geom name="floor" type="plane" size="12 12 0.1" material="floor_mat" density="0"/>
    <body name="base_link" pos="0 0 0.62">
      <freejoint name="root"/>
      <geom name="torso" type="ellipsoid" size="0.13 0.16 0.15" material="duck_yellow" mass="0.34"/>
      <site name="imu_site" pos="0 0 0.04" size="0.008" rgba="0 1 0 0"/>

      <body name="left_hip_yaw_link" pos="0 0.105 -0.11">
        <joint name="left_hip_yaw" axis="0 0 1" range="-0.65 0.65"/>
        <geom type="sphere" size="0.035" material="duck_dark" mass="0.025"/>
        <body name="left_hip_roll_link">
          <inertial pos="0 0 0" mass="0.005" diaginertia="0.00001 0.00001 0.00001"/>
          <joint name="left_hip_roll" axis="1 0 0" range="-0.55 0.55"/>
          <body name="left_thigh_link">
            <joint name="left_hip_pitch" axis="0 1 0" range="-1.1 0.9"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.18" size="0.035" mass="0.10"/>
            <body name="left_shin_link" pos="0 0 -0.18">
              <joint name="left_knee" axis="0 1 0" range="0 1.45"/>
              <geom type="capsule" fromto="0 0 0 0 0 -0.17" size="0.03" mass="0.075"/>
              <body name="left_ankle_pitch_link" pos="0 0 -0.17">
                <inertial pos="0 0 0" mass="0.005" diaginertia="0.00001 0.00001 0.00001"/>
                <joint name="left_ankle_pitch" axis="0 1 0" range="-0.85 0.65"/>
                <body name="left_foot_link">
                  <joint name="left_ankle_roll" axis="1 0 0" range="-0.45 0.45"/>
                  <geom name="left_foot" type="box" pos="0.035 0 -0.025" size="0.095 0.055 0.025" material="beak" mass="0.07"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

      <body name="neck_pitch_link" pos="0 0 0.13">
        <joint name="neck_pitch" axis="0 1 0" range="-0.6 0.6"/>
        <geom type="capsule" fromto="0 0 0 0 0 0.065" size="0.025" material="duck_dark" mass="0.025"/>
        <body name="head_link" pos="0 0 0.075">
          <joint name="head_yaw" axis="0 0 1" range="-1.0 1.0"/>
          <geom type="ellipsoid" size="0.09 0.08 0.075" material="duck_yellow" mass="0.09"/>
          <geom name="beak" type="box" pos="0.095 0 -0.015" size="0.055 0.055 0.022" material="beak" mass="0.025"/>
          <camera name="head_camera" pos="0.075 0 0.025" xyaxes="0 -1 0 0.15 0 0.99" fovy="72"/>
        </body>
      </body>

      <body name="right_hip_yaw_link" pos="0 -0.105 -0.11">
        <joint name="right_hip_yaw" axis="0 0 1" range="-0.65 0.65"/>
        <geom type="sphere" size="0.035" material="duck_dark" mass="0.025"/>
        <body name="right_hip_roll_link">
          <inertial pos="0 0 0" mass="0.005" diaginertia="0.00001 0.00001 0.00001"/>
          <joint name="right_hip_roll" axis="1 0 0" range="-0.55 0.55"/>
          <body name="right_thigh_link">
            <joint name="right_hip_pitch" axis="0 1 0" range="-1.1 0.9"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.18" size="0.035" mass="0.10"/>
            <body name="right_shin_link" pos="0 0 -0.18">
              <joint name="right_knee" axis="0 1 0" range="0 1.45"/>
              <geom type="capsule" fromto="0 0 0 0 0 -0.17" size="0.03" mass="0.075"/>
              <body name="right_ankle_pitch_link" pos="0 0 -0.17">
                <inertial pos="0 0 0" mass="0.005" diaginertia="0.00001 0.00001 0.00001"/>
                <joint name="right_ankle_pitch" axis="0 1 0" range="-0.85 0.65"/>
                <body name="right_foot_link">
                  <joint name="right_ankle_roll" axis="1 0 0" range="-0.45 0.45"/>
                  <geom name="right_foot" type="box" pos="0.035 0 -0.025" size="0.095 0.055 0.025" material="beak" mass="0.07"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="left_hip_yaw_act" joint="left_hip_yaw"/>
    <position name="left_hip_roll_act" joint="left_hip_roll"/>
    <position name="left_hip_pitch_act" joint="left_hip_pitch"/>
    <position name="left_knee_act" joint="left_knee" ctrlrange="0 1.45"/>
    <position name="left_ankle_pitch_act" joint="left_ankle_pitch"/>
    <position name="left_ankle_roll_act" joint="left_ankle_roll"/>
    <position name="neck_pitch_act" joint="neck_pitch"/>
    <position name="head_yaw_act" joint="head_yaw"/>
    <position name="right_hip_yaw_act" joint="right_hip_yaw"/>
    <position name="right_hip_roll_act" joint="right_hip_roll"/>
    <position name="right_hip_pitch_act" joint="right_hip_pitch"/>
    <position name="right_knee_act" joint="right_knee" ctrlrange="0 1.45"/>
    <position name="right_ankle_pitch_act" joint="right_ankle_pitch"/>
    <position name="right_ankle_roll_act" joint="right_ankle_roll"/>
  </actuator>

  <sensor>
    <gyro name="imu_gyro" site="imu_site"/>
    <accelerometer name="imu_accel" site="imu_site"/>
    <framequat name="imu_orientation" objtype="site" objname="imu_site"/>
  </sensor>

  <keyframe>
    <key name="stand" qpos="0 0 0.62 1 0 0 0  0 0 -0.22 0.44 -0.22 0  0 0  0 0 -0.22 0.44 -0.22 0"/>
  </keyframe>
</mujoco>
